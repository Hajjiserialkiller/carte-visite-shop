# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (no trailing slash)
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL="file:./dev.db"

# Stripe (optional — if left empty, checkout runs in demo mode)
STRIPE_SECRET_KEY=
STRIPE_PRICE_CURRENCY=EUR

# Backend URL (used to build Stripe success/cancel URLs)
APP_URL=http://localhost:4000

# Admin dashboard token (any strong random string). Set one to enable /api/admin.
ADMIN_TOKEN=ahmed
